{
  "name": "goldilocks-workbench",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./style.css": "./dist-lib/goldilocks-workbench.css"
  },
  "scripts": {
    "predev": "npm run generate:api",
    "dev": "vite",
    "prebuild": "npm run generate:api",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "prelint": "npm run generate:api",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run generate:api",
    "test": "vitest run",
    "pretest:e2e": "npm run generate:api",
    "test:e2e": "playwright test",
    "generate:openapi": "uv run --frozen --no-sync python ../scripts/export_workbench_openapi.py --output openapi.json",
    "generate:schema": "openapi-typescript openapi.json -o src/api/schema.d.ts --immutable",
    "generate:api": "npm run generate:openapi && npm run generate:schema",
    "precheck": "npm run generate:api",
    "check": "npm run format:check && npm --ignore-scripts run lint && npm --ignore-scripts run test && npm --ignore-scripts run build"
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "3dmol": "2.5.5",
    "lucide-react": "1.66.0",
    "zustand": "5.0.16"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "fflate": "^0.8.3",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    }
  }
}
